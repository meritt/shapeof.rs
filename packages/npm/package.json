{
  "name": "@meritt/shapeof-wasm",
  "version": "0.1.0",
  "description": "Infers JSON Schema 2020-12 from examples of JSON, loose JSON or JSON Lines for structured outputs or validation, in WebAssembly",
  "keywords": [
    "json",
    "json-schema",
    "jsonl",
    "structured-outputs",
    "wasm",
    "webassembly"
  ],
  "license": "MIT",
  "author": {
    "name": "Alexey Simonenko",
    "email": "alexey@simonenko.dev",
    "url": "https://simonenko.xyz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/meritt/shapeof.rs.git",
    "directory": "packages/npm"
  },
  "type": "module",
  "engines": {
    "node": ">=26.13.0"
  },
  "sideEffects": false,
  "exports": {
    ".": "./shapeof.js",
    "./shapeof.wasm": "./shapeof.wasm"
  },
  "files": [
    "shapeof.js",
    "shapeof.wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^26.13.0",
      "onFail": "error"
    }
  }
}
